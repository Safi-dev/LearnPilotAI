# Copy this file to .env and add your own keys. Never commit backend/.env.
DATABASE_URL=sqlite:///./learnpilot.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Create a Gemini API key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
DEMO_MODE=false

# Enable YouTube Data API v3 in Google Cloud Console, then add its key
YOUTUBE_API_KEY=
